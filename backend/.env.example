# Bu dosyayı .env olarak kopyalamayın; değerleri işletim sistemi ortam değişkeni olarak verin.
# 32+ karakter rastgele JWT sırrı
JWT_SECRET=
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
CREDENTIAL_ENCRYPTION_KEY=
APP_DB_URL=jdbc:mysql://localhost:3306/sqleditor_app?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Istanbul
APP_DB_USERNAME=sqleditor_app
APP_DB_PASSWORD=
CORS_ALLOWED_ORIGIN=http://localhost:5173
